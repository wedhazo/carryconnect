# Environment variables for CarryConnect Monitoring Stack
# Copy this file to .env and update with your values

# MySQL Configuration
MYSQL_ROOT_PASSWORD=change_me_in_production
MYSQL_DATABASE=carryconnect
MYSQL_USER=root

# Grafana Configuration
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_in_production

# Note: For production deployments, use strong passwords and consider using
# Docker secrets or a secrets management solution instead of .env files
